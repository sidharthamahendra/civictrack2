pipeline {
  agent any

  environment {
    IMAGE_REPO = "sidharthmahendra66/civictrack-jenkins"
    IMAGE_TAG  = "build-${BUILD_NUMBER}"           // unique tag per build
    LATEST_TAG = "latest"                          // also push 'latest'
    AZ_RG      = "civictrack-rg"
    AZ_LOC     = "eastus"
    AZ_ACI     = "civictrack-aci"                  // container group name
    AZ_DNS     = "civictrack"                // your desired public DNS label
  }

  options { timestamps() }

  stages {
    stage('Checkout') {
      steps { checkout scm }
    }

    stage('Docker Login') {
      steps {
        withCredentials([usernamePassword(credentialsId: 'dockerhub-creds',
                   usernameVariable: 'DH_USER', passwordVariable: 'DH_PASS')]) {
          sh '''
            echo "$DH_PASS" | docker login -u "$DH_USER" --password-stdin
          '''
        }
      }
    }

    stage('Build Image') {
      steps {
        sh '''
          docker build -t ${IMAGE_REPO}:${IMAGE_TAG} .
          docker tag  ${IMAGE_REPO}:${IMAGE_TAG} ${IMAGE_REPO}:${LATEST_TAG}
        '''
      }
    }

    stage('Push to Docker Hub') {
      steps {
        sh '''
          docker push ${IMAGE_REPO}:${IMAGE_TAG}
          docker push ${IMAGE_REPO}:${LATEST_TAG}
        '''
      }
    }

    stage('Deploy to Azure Container Instances') {
      steps {
        withCredentials([
          usernamePassword(credentialsId: 'azure-sp-app',
                           usernameVariable: 'AZ_APPID', passwordVariable: 'AZ_PASSWORD'),
          string(credentialsId: 'azure-tenant-id',         variable: 'AZ_TENANT'),
          string(credentialsId: 'azure-subscription-id',   variable: 'AZ_SUB')
        ]) {
          sh '''
            # Login to Azure with service principal
            az login --service-principal -u "$AZ_APPID" -p "$AZ_PASSWORD" --tenant "$AZ_TENANT" > /dev/null
            az account set --subscription "$AZ_SUB"

            # Ensure RG exists (safe if it already exists)
            az group create --name ${AZ_RG} --location ${AZ_LOC} > /dev/null

            # If a container with same name exists, delete it so we can reuse the same DNS label
            az container delete --resource-group ${AZ_RG} --name ${AZ_ACI} --yes || true

            # Create the new container instance using the freshly-pushed image tag
            az container create \
              --resource-group ${AZ_RG} \
              --name ${AZ_ACI} \
              --image ${IMAGE_REPO}:${IMAGE_TAG} \
              --cpu 1 --memory 1 \
              --ports 80 \
              --dns-name-label ${AZ_DNS} \
              --location ${AZ_LOC} \
              --restart-policy Always

            echo "Waiting for container to be Running..."
            az container wait --resource-group ${AZ_RG} --name ${AZ_ACI} --custom "instanceView.state=='Running'"

            echo "Public URL:"
            az container show --resource-group ${AZ_RG} --name ${AZ_ACI} --query ipAddress.fqdn -o tsv
          '''
        }
      }
    }
  }

  post {
    always {
      sh 'docker logout || true'
      cleanWs()
    }
  }
}
