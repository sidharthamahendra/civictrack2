pipeline {
    agent any

    environment {
        REPO_URL = 'https://github.com/Komakulakavya/civictrack.git'
    }

    stages {
        stage('Checkout') {
            steps {
                echo 'Cloning repository...'
                git url: "${REPO_URL}", branch: 'main'
            }
        }

        stage('Install Dependencies') {
            steps {
                echo 'Installing dependencies (if any)...'
                // No dependencies for plain HTML/CSS/JS, skip this for now
            }
        }

        stage('Build') {
            steps {
                echo 'Building project...'
                // Create dist folder
                bat 'if not exist dist mkdir dist'
                // Copy files to dist folder
                bat 'copy /Y *.html dist\\'
                bat 'copy /Y *.css dist\\'
                bat 'copy /Y *.js dist\\'
            }
        }

        stage('Deploy') {
            steps {
                echo 'Deploying project...'
                // Example: copy to a server (requires credentials configured in Jenkins)
                // bat 'xcopy /E /Y dist\\* \\server\\path\\to\\deploy\\'
            }
        }
    }

    post {
        success {
            echo 'Build and deploy completed successfully!'
        }
        failure {
            echo 'Build failed!'
        }
    }
}
