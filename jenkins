pipeline {
    agent any

    environment {
        IMAGE_NAME = "sidharthmahendra66/civictrack"
        IMAGE_TAG = "latest"
    }

    options {
        timestamps()
    }

    stages {
        stage('Checkout') {
            steps {
                git branch: 'main', url: 'https://github.com/sidharthamahendra/civictrack2.git'
            }
        }

        stage('Docker Login') {
            steps {
                withCredentials([usernamePassword(credentialsId: 'dockerhub', usernameVariable: 'DH_USER', passwordVariable: 'DH_PASS')]) {
                    bat """
                        echo %DH_PASS% | docker login -u %DH_USER% --password-stdin
                    """
                }
            }
        }

        stage('Build Docker Image') {
            steps {
                bat """
                    docker build -t %IMAGE_NAME%:%IMAGE_TAG% .
                """
            }
        }

        stage('Push Image to Docker Hub') {
            steps {
                bat """
                    docker push %IMAGE_NAME%:%IMAGE_TAG%
                """
            }
        }

        stage('Deploy to Azure Container Instances') {
            steps {
                withCredentials([
                    usernamePassword(credentialsId: 'azure-sp-app', usernameVariable: 'AZ_APP_ID', passwordVariable: 'AZ_PASSWORD'),
                    string(credentialsId: 'azure-tenant-id', variable: 'AZ_TENANT_ID'),
                    string(credentialsId: 'azure-subscription-id', variable: 'AZ_SUBSCRIPTION_ID')
                ]) {
                    bat """
                        az login --service-principal -u %AZ_APP_ID% -p %AZ_PASSWORD% --tenant %AZ_TENANT_ID%
                        az account set --subscription %AZ_SUBSCRIPTION_ID%
                        az container create --resource-group civictrack-rg --name civictrack-container --image %IMAGE_NAME%:%IMAGE_TAG% --dns-name-label civictrackapp --ports 80 --location eastus --restart-policy Always
                    """
                }
            }
        }
    }

    post {
        always {
            bat """
                echo Cleaning up local Docker images...
                docker image prune -f
                echo Pipeline completed successfully.
            """
        }
    }
}
